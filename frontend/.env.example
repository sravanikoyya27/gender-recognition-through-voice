# ---------------------------------------------------------------------------
# Frontend configuration template. Copy to `.env.local` for development.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time and are therefore PUBLIC: anyone can read them in the page source.
# Never put secrets in a NEXT_PUBLIC_ variable. Variables without the prefix
# are only available to server-side code (route handlers, server components).
# ---------------------------------------------------------------------------

# --- Public (exposed to the browser) ----------------------------------------
# Base URL of the FastAPI backend. Must match a CORS_ORIGINS entry on the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Display name used in the navigation bar, page titles and footer.
NEXT_PUBLIC_APP_NAME=Gender Recognition Through Voice

# --- Server-only (never sent to the browser) ---------------------------------
# Used by next-auth if server-side sessions are enabled in the auth phase.
# Generate with:  openssl rand -base64 32
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
