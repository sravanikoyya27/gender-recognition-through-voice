# ---------------------------------------------------------------------------
# Backend configuration template.
# Copy to `.env` (git-ignored) and fill in real values. Every variable has a
# safe development default in app/config.py, so only override what you need.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | staging | production. In production JWT_SECRET_KEY must be set.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---------------------------------------------------
# SQLAlchemy URL. Matches the docker-compose / `docker run` example in README.
DATABASE_URL=postgresql+psycopg2://voice:voice@localhost:5432/voice_gender

# --- AWS (optional; used for S3 audio storage and deployment) ---------------
# Uploads to S3 happen only when S3_ENABLED=true AND S3_BUCKET_NAME is set; a bucket name alone
# never enables them and example/placeholder values are rejected. Never commit real keys.
S3_ENABLED=false
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Authentication (JWT) ----------------------------------------------------
# A random value of at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With ENVIRONMENT=production the API refuses to start on the default, an example value
# or a low-variety string (checked without logging the value).
JWT_SECRET_KEY=replace-with-a-long-random-string-of-32-plus-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS=90

# --- Caching -----------------------------------------------------------------
# Optional Redis for the analytics cache (user statistics, 1 h TTL). Unset -> in-memory cache.
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- ML artifacts ------------------------------------------------------------
# The production model is deployed by ml_models/model_comparison.py into app/ml/models/
# together with model_config.json (feature order, class mapping, scaler, hashes).
# MODEL_MANIFEST_PATH=app/ml/models/model_config.json
# MODEL_PATH=app/ml/models/model_mlp.h5
# SCALER_PATH=app/ml/models/scaler_mlp.pkl

# --- Uploads / predictions ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.webm,.ogg,.flac
MIN_AUDIO_SECONDS=1.0
MAX_AUDIO_SECONDS=10.0
# Predictions require a JWT by default. Set to false to allow anonymous predictions (demo).
PREDICTIONS_REQUIRE_AUTH=true
MAX_BATCH_FILES=10
