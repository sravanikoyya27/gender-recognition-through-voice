# ---------------------------------------------------------------------------
# Docker Compose environment. Copy to `.env` (git-ignored) in this directory:
#   cp .env.example .env
# Values here feed docker-compose.yml (variable interpolation) and are passed to the
# backend container through `env_file`. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# Database
# DATABASE_URL is derived from the POSTGRES_* values by docker-compose.yml; set it here only
# to point the backend at another PostgreSQL. The host inside the stack is the service name.
DATABASE_URL=postgresql://postgres:your_password@postgres:5432/voicedb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=voicedb
# Host port published for database tools (the containers always use postgres:5432).
# Use 5433 if another PostgreSQL (e.g. the standalone dev container voice-gender-db) owns 5432.
POSTGRES_PORT=5432

# AWS (optional: S3 storage of uploaded recordings; leave the keys empty to disable)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=gender-voice-bucket

# JWT (at least 32 characters; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=your_secret_key_at_least_32_chars

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Cache (the redis service; unset to fall back to the in-memory cache)
REDIS_URL=redis://redis:6379/0

# Frontend
# URL the BROWSER uses to reach the API (published port). Baked into the bundle at build time:
# change it, then `docker compose build frontend`.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Gender Recognition Through Voice

# Deployment (written by infrastructure/deploy.sh on the server; leave unset to build locally)
# BACKEND_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/voice-backend:<commit-sha>
# FRONTEND_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/voice-frontend:<commit-sha>
