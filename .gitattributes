# ---------------------------------------------------------------------------
# Line endings: normalise everything to LF in the repository.
# Windows-only scripts keep CRLF on checkout.
# ---------------------------------------------------------------------------
*               text=auto eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Source / config (explicit so diffs get language-aware hunk headers)
*.py            text diff=python
*.pyi           text diff=python
*.js            text
*.jsx           text
*.ts            text
*.tsx           text
*.json          text
*.yml           text
*.yaml          text
*.toml          text
*.ini           text
*.cfg           text
*.md            text diff=markdown
*.txt           text
*.csv           text
*.html          text diff=html
*.css           text diff=css
*.sh            text eol=lf
Dockerfile      text
*.sql           text

# ---------------------------------------------------------------------------
# Binary assets
# ---------------------------------------------------------------------------
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           text
*.pdf           binary
*.wav           binary
*.mp3           binary
*.flac          binary
*.ogg           binary
*.webm          binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.eot           binary

# ---------------------------------------------------------------------------
# Large ML artifacts: stored via Git LFS when they are intentionally tracked.
# (.gitignore excludes them by default; these rules apply to any that are
# explicitly added, e.g. a released model under a whitelisted path.)
# ---------------------------------------------------------------------------
*.h5            filter=lfs diff=lfs merge=lfs -text
*.hdf5          filter=lfs diff=lfs merge=lfs -text
*.pkl           filter=lfs diff=lfs merge=lfs -text
*.pickle        filter=lfs diff=lfs merge=lfs -text
*.joblib        filter=lfs diff=lfs merge=lfs -text
*.keras         filter=lfs diff=lfs merge=lfs -text
*.onnx          filter=lfs diff=lfs merge=lfs -text
*.npz           filter=lfs diff=lfs merge=lfs -text
*.npy           filter=lfs diff=lfs merge=lfs -text
*.safetensors   filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------------------------
# Exclude from GitHub language statistics / diffs
# ---------------------------------------------------------------------------
package-lock.json   -diff linguist-generated
pnpm-lock.yaml      -diff linguist-generated
yarn.lock           -diff linguist-generated
docs/**             linguist-documentation
